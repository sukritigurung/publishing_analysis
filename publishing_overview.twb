    <worksheet name='rev_price_range'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontalignment='1'>Average Revenue by Price Range</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='postgres' name='federated.0xls5fr01nla7w172aban16mnqbd' />
          </datasources>
          <datasource-dependencies datasource='federated.0xls5fr01nla7w172aban16mnqbd'>
            <column caption='price_ranges' datatype='string' name='[Calculation_0597601050284073]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [sale_price] &lt; 5 THEN &quot;Under $5&quot;&#13;&#10;ELSEIF [sale_price] &gt;=5 AND [sale_price] &lt;= 10 THEN &quot;$5 - $10&quot;&#13;&#10;ELSEIF [sale_price] &gt;= 10 AND [sale_price] &lt;= 20 THEN &quot;$10 - $20&quot;&#13;&#10;ELSE &quot;$20+&quot;&#13;&#10;END' />
            </column>
            <column-instance column='[publisher_revenue]' derivation='Avg' name='[avg:publisher_revenue:qk]' pivot='key' type='quantitative' />
