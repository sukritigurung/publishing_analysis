            <properties context=''>
              <relation connection='postgres.147btyg0vvp80415tvfu00a46k7x' name='Custom SQL Query' type='text'>SELECT&#13;
    view_publisher_name&#13;
    , COUNT(*) AS number_of_titles&#13;
    , ROUND(SUM(publisher_revenue),2) AS total_revenue&#13;
    , ROUND(SUM(publisher_revenue) / COUNT(*),2) AS revenue_per_title&#13;
FROM&#13;
    books_data_view&#13;
GROUP BY&#13;
    view_publisher_name</relation>
            </properties>
          </object>
          <object caption='publisher_avg_book_rating' id='_27D0BC4D19B245579756B34006A2BABD'>
            <properties context=''>
              <relation connection='postgres.147btyg0vvp80415tvfu00a46k7x' name='Custom SQL Query1' type='text'>SELECT&#13;
    view_publisher_name&#13;
    , COUNT(*) AS number_of_titles&#13;
    , ROUND(AVG(book_average_rating),2) AS avg_book_rating&#13;
FROM&#13;
    books_data_view&#13;
GROUP BY&#13;
    view_publisher_name</relation>
            </properties>
          </object>
