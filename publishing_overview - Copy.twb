    , COUNT(*) AS number_of_titles&#13;
    , ROUND(SUM(publisher_revenue),2) AS total_revenue&#13;
    , ROUND(SUM(publisher_revenue) / COUNT(*),2) AS revenue_per_title&#13;
FROM&#13;
    books_data_view&#13;
GROUP BY&#13;
    view_publisher_name</relation>
